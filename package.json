{
  "name": "developers-room",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src *.json *.mjs IMPLEMENTATION_PLAN.md README.md",
    "format:check": "prettier --check src *.json *.mjs IMPLEMENTATION_PLAN.md README.md",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "gsap": "^3.15.0",
    "next": "^16.3.5",
    "react": "19.2",
    "react-dom": "19.2",
    "three": "^0.186.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "prettier": "^3.9.7",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "type": "module"
}
